<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:name=".Myapp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MinechapApp"
        tools:targetApi="31"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">
    <activity
        android:name=".SplashActivity"
        android:exported="true"
        android:theme="@style/Theme.MinechapApp.Splash">
        <intent-filter>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent-filter>
    </activity>
    <activity
        android:name=".Login"
        android:exported="true" />
    <activity
        android:name=".RegisterActivity"
        android:exported="true" />
    <activity
        android:name=".chatActivity"
        android:exported="true" />
    <activity
        android:name=".UsuariosActivos"
        android:exported="true" />

        <activity
            android:name=".ConfigGrupoActivity"
            android:exported="true" />

    <activity
        android:name=".GrupoChatActivity"
        android:exported="true" />
    <activity
        android:name=".NombreGrupoActivity"
        android:exported="true" />
    <activity
        android:name=".inicioActivity"
        android:exported="true" />
        <activity
        android:name=".GrupoActivity"
        android:exported="true" />
        <activity
            android:name=".EditPerfil"
            android:exported="true"
        android:windowSoftInputMode="adjustResize|stateHidden"/>
        <activity
            android:name=".FullscreenImageActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />
        <service
            android:name=".Notificaciones_push"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT"/>
            </intent-filter>
        </service>
</application>
    </manifest>
