<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="end"
    android:padding="8dp">
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bubble_sent"
        android:elevation="2dp"
        android:padding="12dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="4dp">
    <TextView
        android:id="@+id/tvNombreUsuarioEnviado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tú"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:visibility="gone" />
    <ImageView
        android:id="@+id/imgMensajeEnviado"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:scaleType="centerCrop"
        android:background="@drawable/redondeado_image"
        android:clipToOutline="true"
        android:visibility="gone"
        android:layout_marginTop="4dp" />
    <TextView
        android:id="@+id/tvMensajeEnviado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mensaje enviado"
        android:textColor="@android:color/black"
        android:textSize="16sp"
        android:layout_marginTop="4dp"/>
    <TextView
        android:id="@+id/tvHoraMensajeEnviado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="12:45 PM"
        android:textSize="10sp"
        android:textColor="#757575"
        android:layout_gravity="end"
        android:layout_marginTop="4dp"
        android:paddingTop="2dp"/>
</LinearLayout>
    </LinearLayout>
