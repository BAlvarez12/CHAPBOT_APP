<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- IMPORTANTE: permiso de internet -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_background"
        android:supportsRtl="true"
        android:theme="@style/Theme.MinechapApp"
        tools:targetApi="31">

        <!-- SplashActivity (primera pantalla) -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Activity de login (segundo) -->
        <activity
            android:name=".Login"
            android:exported="true"/>

        <!-- Activity de registro -->
        <activity
            android:name=".RegisterActivity"
            android:exported="true"/>

        <!-- MainActivity (pantalla principal) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"/>
    </application>
</manifest>
